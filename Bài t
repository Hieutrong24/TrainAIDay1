    "class TitanicPreprocessor:\n",
    "    def __init__(self):\n",
    "        self.age_mapping = {}\n",
    "    def feature_engineering(self, df, is_train=True):\n",
    "        df = df.copy()\n",
    "        df['Title'] = df['Name'].str.extract(r'([A-Za-z]+)\\.', expand=False)\n",
    "\n",
    "        title_mapping = {\n",
    "            'Mr': 'Mr', 'Miss': 'Miss', 'Mrs': 'Mrs', 'Master': 'Master',\n",
    "            'Dr': 'Rare', 'Rev': 'Rare', 'Col': 'Rare', 'Major': 'Rare',\n",
    "            'Mlle': 'Miss', 'Countess': 'Rare', 'Ms': 'Miss', 'Lady': 'Rare',\n",
    "            'Jonkheer': 'Rare', 'Don': 'Rare', 'Dona': 'Rare', 'Mme': 'Mrs',\n",
    "            'Capt': 'Rare', 'Sir': 'Rare'\n",
    "        }\n",
    "        df['Title'] = df['Title'].map(title_mapping)\n",
    "        df['Title'].fillna('Rare', inplace=True)\n",
    "\n",
    "\n",
    "        df['FamilySize'] = df['SibSp'] + df['Parch'] +1\n",
    "        df['IsAlone'] = (df['FamilySize']==1).astype(int)\n",
    "\n",
    "        if is_train:\n",
    "            self.age_mapping = df.groupby('Title')['Age'].median().to_dict()\n",
    "        for title, median_age in self.age_mapping.items():\n",
    "            df.loc[(df['Age'].isnull()) & (df['Title'] == title), 'Age'] = median_age\n",
    "\n",
    "        if df['Age'].isnull().any():\n",
    "            df['Age'].fillna(df['Age'].median(), inplace=True)\n",
    "\n",
    "        df['AgeGroup'] = pd.cut(df['Age'], bins=[0,12,18,35,60,199],\n",
    "                               labels = ['Child', 'Teen','Adult', 'Middle', 'Senior'])\n",
    "\n",
    "        df['Embarked'].fillna(df['Embarked'].mode()[0], inplace=True)\n",
    "        if df['Fare'].isnull().any():\n",
    "            df['Fare'].fillna(df['Fare'].median(), inplace=True)\n",
    "\n",
    "        try:\n",
    "            df['FareGroup'] = pd.cut(df['Fare'], q=4, labels=['Low','Medium', 'High','Verry_High'])\n",
    "        except Exception:\n",
    "            df['FareGroup'] = pd.cut(df['Fare'], bins=4, labels=['Low','Medium','High', 'Very_High'])\n",
    "\n",
    "        df['Deck'] = df['Cabin'].astype(str).str[0]\n",
    "        df['Deck'].replace('n', 'Unknown', inplace=True)  # 'nan' -> 'n' char fallback\n",
    "        df['Deck'].fillna('Unknown', inplace=True)\n",
    "\n",
    "        df['Deck'].fillna('Unknown',inplace=True)\n",
    "\n",
    "        df['HasCabin'] = (~df['Cabin'].isnull()) & (df['Cabin'].astype(str).str.strip() != '')\n",
    "        df['HasCabin'] = df['HasCabin'].astype(int)\n",
    "        return df\n",
    "    def prepare_data(self, train_df, test_df=None):\n",
    "        train_processed = self.feature_engineering(train_df, is_train=True)\n",
    "        if test_df is not None:\n",
    "            test_processed = self.feature_engineering(test_df, is_train=False)\n",
    "        features = ['Pclass','Sex','Age','SibSp','Parch','Fare','Embarked',\n",
    "                    'Title','FamilySize','IsAlone','AgeGroup','FareGroup','Deck','HasCabin']\n",
    "        \n",
    "        X_train = train_processed[features].copy()\n",
    "\n",
    "        y_train = train_processed['Survived'].copy()\n",
    "\n",
    "        categorical_features = ['Sex','Embarked','Title','AgeGroup','FareGroup','Deck']\n",
    "        X_train_encoded = pd.get_dummies(X_train, columns=categorical_features, drop_first=True)\n",
    "        if test_df is not None:\n",
    "            X_test = test_processed[features].copy()\n",
    "            X_test_encoded = pd.get_dummies(X_test, columns=categorical_features, drop_first=True)\n",
    "            X_test_encoded = X_test_encoded.reindex(columns=X_train_encoded.columns, fill_value=0)\n",
    "            return X_train_encoded, X_test_encoded, y_train\n",
    "        return X_train_encoded, y_train"
   ]
  },
